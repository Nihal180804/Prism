# ── Email (Gmail SMTP with an app password) ──────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ── Local LLM (LM Studio) ────────────────────────────────────────────────────
MISTRAL_URL=http://127.0.0.1:1234/v1/chat/completions
MISTRAL_MODEL=mistral-7b-instruct-v0.3

# ── Server ───────────────────────────────────────────────────────────────────
# HOST defaults to 127.0.0.1 (localhost only). Use 0.0.0.0 to expose on the
# network — only do this with RECRUITER_PASSWORD set and ideally behind HTTPS.
HOST=127.0.0.1
PORT=5000
# Flask session signing key. If unset, a random one is generated per start.
SECRET_KEY=
# Comma-separated allowed origins for Socket.IO (default: *).
CORS_ALLOWED_ORIGINS=*

# ── Recruiter dashboard auth ─────────────────────────────────────────────────
# If RECRUITER_PASSWORD is unset, the dashboard is UNPROTECTED (local dev only).
# Set it to require HTTP Basic Auth on /recruiter and all /api routes.
RECRUITER_USER=recruiter
RECRUITER_PASSWORD=

# ── Webcam / face monitor ────────────────────────────────────────────────────
# Camera device index (0 is usually the built-in webcam).
CAMERA_INDEX=0
# Seconds with no face before a warning, and (if auto-exit is on) before ending.
FACE_WARN_SECONDS=3
FACE_EXIT_SECONDS=15
# Auto-end the interview when the candidate leaves frame. Off by default — a
# missed face detection should not kill an interview. Set to 1 to enable.
FACE_AUTO_EXIT=0

# ── Dev / testing ────────────────────────────────────────────────────────────
# Set to 1 to enable the "Start a practice session" helper on the candidate
# portal (creates a ready-to-run coding+verbal session with no email/resume).
# Leave 0 in any real deployment.
PRISM_DEV=0
