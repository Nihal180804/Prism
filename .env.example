# ── Email (Gmail SMTP with an app password) ──────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ── Local LLM (OpenAI-compatible endpoint: LM Studio / Ollama / vLLM) ─────────
# LLM_URL / LLM_MODEL are the canonical names. The older MISTRAL_URL /
# MISTRAL_MODEL are still honoured if LLM_* are unset, so existing setups work.
LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LLM_MODEL=mistral-7b-instruct-v0.3
# Per-request timeout (seconds) and how many times to retry on failure.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── Interviewer agent ────────────────────────────────────────────────────────
# The interview is run by a tool-using agent that asks the planned questions and
# may add dynamic follow-ups. Set AGENT_ENABLED=0 for a deterministic linear
# interview with no LLM decisions (also the automatic fallback if the model is
# offline). AGENT_MAX_FOLLOWUPS caps dynamic follow-ups per interview.
AGENT_ENABLED=1
AGENT_MAX_FOLLOWUPS=3
# Extra CODING questions the agent may add when unsatisfied with a coding answer,
# and the live-review correctness (0-100) at/below which an answer counts as weak.
AGENT_MAX_CODE_FOLLOWUPS=2
AGENT_CODE_FOLLOWUP_THRESHOLD=70
AGENT_MAX_STEPS=40

# ── Uploads ──────────────────────────────────────────────────────────────────
# Max size (bytes) of a single upload request (resumes + JD). Default 25 MB.
MAX_CONTENT_LENGTH=26214400

# ── Server ───────────────────────────────────────────────────────────────────
# HOST defaults to 127.0.0.1 (localhost only). Use 0.0.0.0 to expose on the
# network — only do this with RECRUITER_PASSWORD set and ideally behind HTTPS.
HOST=127.0.0.1
PORT=5000
# Flask session signing key. If unset, a random one is generated per start.
SECRET_KEY=
# Comma-separated allowed origins for Socket.IO (default: *).
CORS_ALLOWED_ORIGINS=*

# ── Recruiter dashboard auth ─────────────────────────────────────────────────
# If RECRUITER_PASSWORD is unset, the dashboard is UNPROTECTED (local dev only).
# Set it to require HTTP Basic Auth on /recruiter and all /api routes.
RECRUITER_USER=recruiter
RECRUITER_PASSWORD=

# ── Media features (per-interview; recruiter toggles these on the dashboard) ──
# These are the DEFAULTS used when a session's meta doesn't specify. When a
# feature is off, the candidate UI hides its control entirely (no dead space).
TTS_ENABLED=0            # read questions aloud with Kokoro-82M (needs: pip install kokoro soundfile)
STT_ENABLED=0            # voice answers: browser mic → server Whisper (needs: pip install faster-whisper)
CAMERA_ENABLED=0         # webcam presence / face monitor
CLARIFY_ENABLED=1        # candidate may ask the AI to clarify a question (hint-only)
CLARIFY_MAX_PER_QUESTION=2

# TTS (Kokoro-82M)
TTS_VOICE=af_heart
TTS_LANG_CODE=a          # 'a' = American English
TTS_SAMPLE_RATE=24000

# STT (faster-whisper — the RealtimeSTT engine)
STT_MODEL=base.en
STT_COMPUTE_TYPE=int8

# ── Device placement (LLM on GPU; STT/TTS default to CPU to spare VRAM) ───────
# 'auto' | 'cpu' | 'cuda'. 'auto' only puts an audio model on the GPU when there
# is at least GPU_AUDIO_MIN_FREE_VRAM_MB free — otherwise it stays on the CPU so
# the LLM keeps the VRAM (the common case on 6–8 GB laptops).
STT_DEVICE=auto
TTS_DEVICE=auto
GPU_AUDIO_MIN_FREE_VRAM_MB=7000

# ── Face monitor (candidate's browser captures the webcam; frames POSTed to
#    the server for the OpenCV presence check — no server-side camera) ──────────
# Seconds with no face before a warning, and (if auto-exit is on) before ending.
FACE_WARN_SECONDS=3
FACE_EXIT_SECONDS=15
# Auto-end the interview when the candidate leaves frame. Off by default — a
# missed face detection should not kill an interview. Set to 1 to enable.
FACE_AUTO_EXIT=0

# ── Dev / testing ────────────────────────────────────────────────────────────
# Set to 1 to enable the "Start a practice session" helper on the candidate
# portal (creates a ready-to-run coding+verbal session with no email/resume).
# Leave 0 in any real deployment.
PRISM_DEV=0
